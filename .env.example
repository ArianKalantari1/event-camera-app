# ---- app -------------------------------------------------------------------
# Swappable: the canonical origin the QR codes encode. Change this when the
# real domain is decided; nothing else should hard-code an origin.
APP_URL=http://localhost:3000

# HMAC key for attendee device-session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-insecure-secret-change-me

# ---- database --------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/event_camera

# ---- media storage ---------------------------------------------------------
# local = filesystem under .storage (no credentials needed, for development)
# s3    = any S3-compatible endpoint: Cloudflare R2, AWS S3, MinIO
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage

# Only read when STORAGE_DRIVER=s3. Plain S3 API only, so the provider
# decision stays reversible — see docs/mvp-prd.md §1.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---- moderation ------------------------------------------------------------
# Demo Zero only: the organizer console sits behind this unguessable path
# segment instead of real auth. Replaced by magic-link auth in Milestone 1.
ORGANIZER_CONSOLE_KEY=dev-console-key
